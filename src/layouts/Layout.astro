---
import { Terminal, Sparkles } from 'lucide-astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}

const {
  title,
  description = "WEB制作・マーケティング・SNS運用者向け。ワンクリックでコピペして業務を激変させる実戦AIプロンプト集。",
  image = "/ogp-default.png",
  type = "website",
  publishedTime,
} = Astro.props;

// Canonical URL calculation
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogpImageURL = new URL(image, Astro.site);

// Placeholder IDs for Google Search Console & GA4
// Users can set these via environment variables or edit here
const GOOGLE_SITE_VERIFICATION = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "";
const GA4_MEASUREMENT_ID = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || "";
---

<!doctype html>
<html lang="ja" class="scroll-smooth bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}/sitemap-index.xml`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogpImageURL} />
    <meta property="og:site_name" content="PromptHub" />
    <meta property="og:locale" content="ja_JP" />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogpImageURL} />

    <!-- Google Search Console Verification Placeholder -->
    {GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    )}

    <!-- Google Analytics 4 (gtag.js) -->
    {GA4_MEASUREMENT_ID && (
      <>
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA4_MEASUREMENT_ID}`}
        />
        <script is:inline define:vars={{ GA4_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA4_MEASUREMENT_ID);
        </script>
      </>
    )}

    <!-- Additional head items like JSON-LD schema -->
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col font-sans antialiased selection:bg-brand-500 selection:text-white bg-slate-950">
    <!-- Background grid decoration -->
    <div class="fixed inset-0 pointer-events-none -z-10 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-40"></div>

    <!-- Header Navigation -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/80">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
            <Terminal class="w-5 h-5 text-white" />
          </div>
          <div>
            <span class="text-lg font-extrabold tracking-tight text-white group-hover:text-brand-300 transition-colors">PromptHub</span>
            <span class="text-xs ml-1.5 px-2 py-0.5 rounded font-mono bg-brand-500/10 text-brand-400 border border-brand-500/20 hidden sm:inline">PROMPT MEDIA</span>
          </div>
        </a>

        <div class="flex items-center gap-3 sm:gap-4">
          <a
            href={import.meta.env.BASE_URL}
            class="text-sm font-medium text-slate-300 hover:text-white transition-colors"
          >
            プロンプト一覧
          </a>
          <a
            href={`${import.meta.env.BASE_URL}/survey/`}
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-lg bg-amber-500/10 text-amber-300 border border-amber-500/30 hover:bg-amber-500/20 transition-all hover:scale-105"
          >
            <Sparkles class="w-3.5 h-3.5 text-amber-400" />
            <span>特典プレゼント</span>
          </a>
          <a
            href="https://note.com/prompt_hub_official"
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="header-note"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold px-3.5 py-1.5 rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700 border border-slate-700 transition-all hover:scale-105"
          >
            <span>完全自動化note</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-slate-800/80 bg-slate-950/90 py-10">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-md bg-brand-600 flex items-center justify-center text-white">
            <Terminal class="w-3.5 h-3.5 text-white" />
          </div>
          <span class="font-bold text-slate-300 text-sm">PromptHub</span>
          <span>— AI業務自動化プロンプト配布メディア</span>
        </div>
        <p class="text-center md:text-right">
          © {new Date().getFullYear()} PromptHub. All rights reserved. 業務効率化・自動化のための実践ナレッジ
        </p>
      </div>
    </footer>
  </body>
</html>
