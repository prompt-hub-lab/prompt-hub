---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Zap, Clock, Cpu, Calendar, ArrowRight, Sparkles, Filter } from 'lucide-astro';

// Fetch all prompts sorted by pubDate descending
const prompts = await getCollection('prompts');
const sortedPrompts = prompts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const categories = [
  'すべて',
  'SEO・ブログ',
  'SNS・X運用',
  'LP・コピーライティング',
  'Claude Code自動化',
  'ディレクション',
];

const categoryColorMap: Record<string, string> = {
  'SEO・ブログ': 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30',
  'SNS・X運用': 'text-sky-400 bg-sky-500/10 border-sky-500/30',
  'LP・コピーライティング': 'text-amber-400 bg-amber-500/10 border-amber-500/30',
  'Claude Code自動化': 'text-purple-400 bg-purple-500/10 border-purple-500/30',
  'ディレクション': 'text-rose-400 bg-rose-500/10 border-rose-500/30',
};
---

<Layout title="PromptHub | コピペで業務を自動化する実戦プロンプト集">
  <!-- Hero Section -->
  <section class="text-center py-12 md:py-16 space-y-6 max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-brand-500/10 text-brand-300 border border-brand-500/30 shadow-sm animate-pulse">
      <Sparkles class="w-3.5 h-3.5 text-brand-400" />
      <span>Web制作・マーケ・SNS運用者のための実務直結プロンプト</span>
    </div>

    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
      コピペで業務を自動化する<br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-400 via-sky-300 to-indigo-300">
        実戦AIプロンプト集
      </span>
    </h1>

    <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
      検証済みのプロンプトをワンクリックでコピー。記事構成・フック量産・LPオファー作成など、毎日の繰り返し業務を一瞬で終わらせる実践知を提供します。
    </p>

    <!-- Quick stat badges -->
    <div class="pt-2 flex flex-wrap justify-center items-center gap-6 text-xs text-slate-400">
      <div class="flex items-center gap-1.5">
        <Zap class="w-4 h-4 text-amber-400" />
        <span>ワンクリック即時コピー対応</span>
      </div>
      <div class="flex items-center gap-1.5">
        <Clock class="w-4 h-4 text-emerald-400" />
        <span>作業時間を最大85%削減</span>
      </div>
      <div class="flex items-center gap-1.5">
        <Cpu class="w-4 h-4 text-sky-400" />
        <span>Claude 3.7 / ChatGPT / Claude Code対応</span>
      </div>
    </div>
  </section>

  <!-- Category Filter Bar -->
  <section class="mt-8 mb-10" id="filter-section">
    <div class="flex items-center gap-2 mb-3 text-xs font-semibold uppercase tracking-wider text-slate-400">
      <Filter class="w-3.5 h-3.5 text-brand-400" />
      <span>カテゴリで絞り込む</span>
    </div>

    <div class="flex flex-wrap gap-2" id="category-filter-container">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category-filter={cat}
          class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer ${
            idx === 0
              ? 'bg-brand-500 text-white shadow-md shadow-brand-500/20 active'
              : 'bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-slate-700'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  <!-- Prompt Cards Grid -->
  <section>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="prompts-grid">
      {sortedPrompts.map((item) => {
        const catBadgeStyle = categoryColorMap[item.data.category] || 'text-slate-300 bg-slate-800 border-slate-700';
        const formattedDate = item.data.pubDate.toLocaleDateString('ja-JP', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        });

        return (
          <article
            class="prompt-card group flex flex-col justify-between rounded-2xl bg-slate-900/90 border border-slate-800/90 hover:border-brand-500/50 hover:bg-slate-900 p-6 transition-all duration-300 hover:shadow-xl hover:shadow-brand-500/5 hover:-translate-y-1"
            data-category={item.data.category}
          >
            <div class="space-y-4">
              <!-- Top Badges -->
              <div class="flex items-center justify-between gap-2">
                <span class={`inline-block px-2.5 py-1 rounded-md text-xs font-semibold border ${catBadgeStyle}`}>
                  {item.data.category}
                </span>

                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-2 py-0.5 rounded-full">
                  <Clock class="w-3 h-3" />
                  {item.data.timeSaved}
                </span>
              </div>

              <!-- Title -->
              <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-brand-300 transition-colors line-clamp-2">
                <a href={`${import.meta.env.BASE_URL}/prompt/${item.slug}/`} class="focus:outline-none focus:underline">
                  {item.data.title}
                </a>
              </h2>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-slate-400 line-clamp-3 leading-relaxed">
                {item.data.description}
              </p>
            </div>

            <!-- Footer Meta -->
            <div class="pt-5 mt-5 border-t border-slate-800/80 flex items-center justify-between text-xs text-slate-400">
              <div class="flex items-center gap-1.5 text-slate-300">
                <Cpu class="w-3.5 h-3.5 text-brand-400" />
                <span class="font-mono text-[11px]">{item.data.targetModel}</span>
              </div>

              <div class="flex items-center gap-3">
                <span class="flex items-center gap-1 text-[11px] text-slate-400">
                  <Calendar class="w-3 h-3 text-slate-400" />
                  {formattedDate}
                </span>
                <a
                  href={`${import.meta.env.BASE_URL}/prompt/${item.slug}/`}
                  class="inline-flex items-center justify-center w-7 h-7 rounded-lg bg-slate-800 group-hover:bg-brand-500 group-hover:text-white text-slate-300 transition-colors"
                  aria-label={`${item.data.title}の詳細を見る`}
                >
                  <ArrowRight class="w-3.5 h-3.5" />
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Load More Button -->
    <div class="mt-10 text-center" id="load-more-wrapper">
      <button
        id="load-more-btn"
        type="button"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 border border-slate-700 hover:border-brand-500/80 hover:bg-slate-800 text-slate-200 hover:text-white font-medium text-sm transition-all duration-200 shadow-lg shadow-black/20 hover:shadow-brand-500/10 cursor-pointer"
      >
        <span id="load-more-text">プロンプトをもっと見る（+9件）</span>
        <ArrowRight class="w-4 h-4 text-brand-400 transition-transform group-hover:translate-x-0.5" />
      </button>
    </div>

    <!-- Empty state (hidden by default) -->
    <div id="no-results-msg" class="hidden text-center py-16 text-slate-400 space-y-2">
      <p class="text-base font-semibold">該当するプロンプトは見つかりませんでした。</p>
      <p class="text-xs">他のカテゴリを選択してください。</p>
    </div>
  </section>

  <!-- Free Experience Offer Banner (Subtle / Non-salesy) -->
  <section class="mt-16 sm:mt-24">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-slate-900/90 to-brand-950/40 border border-slate-800/80 p-8 sm:p-10 shadow-2xl">
      <!-- Glow ambient background -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-semibold">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-pulse"></span>
            無料プレゼント配布中
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-snug">
            実務プロンプト完全版データベース（Notion）＆<br class="hidden sm:inline" />自動化スターターキット無料配布中
          </h2>
          <p class="text-sm text-slate-400 leading-relaxed">
            サイト掲載中の全プロンプトをワンクリック複製できるNotionマスターデータベースと、Claude Code・Cursorの自動化設定ファイルを無料プレゼントしています。簡単な1分アンケートにご回答いただくと、完了画面およびメールにて即座にお届けします。
          </p>
        </div>

        <div class="flex-shrink-0 w-full sm:w-auto">
          <a
            href={`${import.meta.env.BASE_URL}/survey/`}
            class="inline-flex items-center justify-center gap-2.5 w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-brand-500 to-indigo-600 hover:from-brand-400 hover:to-indigo-500 text-white font-semibold text-sm shadow-xl shadow-brand-500/20 hover:shadow-brand-500/30 transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <span>特典を無料で受け取る</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <p class="text-[11px] text-slate-500 text-center sm:text-right mt-2">
            ※ 1分で完了・迷惑メールの送信はありません
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  function setupPromptCardsPagination() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-category-filter]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.prompt-card'));
    const noResultsMsg = document.getElementById('no-results-msg');
    const loadMoreBtn = document.getElementById('load-more-btn');
    const loadMoreWrapper = document.getElementById('load-more-wrapper');
    const loadMoreText = document.getElementById('load-more-text');

    if (!cards.length) return;

    const PAGE_SIZE = 9;
    let currentLimit = PAGE_SIZE;
    let currentCategory = 'すべて';

    function updateCardVisibility() {
      // 1. Filter cards by selected category
      const matchedCards = cards.filter((card) => {
        const cat = card.getAttribute('data-category');
        return currentCategory === 'すべて' || cat === currentCategory;
      });

      // 2. Hide all cards initially
      cards.forEach((card) => {
        card.classList.add('hidden');
      });

      // 3. Show only matched cards up to currentLimit
      matchedCards.slice(0, currentLimit).forEach((card) => {
        card.classList.remove('hidden');
      });

      // 4. Update empty state
      if (noResultsMsg) {
        if (matchedCards.length === 0) {
          noResultsMsg.classList.remove('hidden');
        } else {
          noResultsMsg.classList.add('hidden');
        }
      }

      // 5. Update Load More button
      if (loadMoreWrapper && loadMoreBtn) {
        const remaining = matchedCards.length - currentLimit;
        if (remaining > 0) {
          loadMoreWrapper.classList.remove('hidden');
          const nextCount = Math.min(PAGE_SIZE, remaining);
          if (loadMoreText) {
            loadMoreText.textContent = `プロンプトをもっと見る（+${nextCount}件 / 残り${remaining}件）`;
          }
        } else {
          loadMoreWrapper.classList.add('hidden');
        }
      }
    }

    // Category button click handlers
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category-filter') || 'すべて';
        currentLimit = PAGE_SIZE; // Reset limit on category switch

        // Update button active styling
        filterButtons.forEach((b) => {
          b.classList.remove('bg-brand-500', 'text-white', 'shadow-md', 'shadow-brand-500/20', 'active');
          b.classList.add('bg-slate-900', 'text-slate-300', 'border', 'border-slate-800');
        });
        btn.classList.add('bg-brand-500', 'text-white', 'shadow-md', 'shadow-brand-500/20', 'active');
        btn.classList.remove('bg-slate-900', 'text-slate-300', 'border-slate-800');

        updateCardVisibility();
      });
    });

    // Load More click handler
    if (loadMoreBtn) {
      loadMoreBtn.onclick = () => {
        currentLimit += PAGE_SIZE;
        updateCardVisibility();
      };
    }

    // Initial render
    updateCardVisibility();
  }

  setupPromptCardsPagination();
  document.addEventListener('astro:page-load', setupPromptCardsPagination);
</script>
