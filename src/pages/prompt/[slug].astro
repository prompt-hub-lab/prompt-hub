---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CopyButton from '../../components/CopyButton.astro';
import ConversionBanner from '../../components/ConversionBanner.astro';
import { ChevronRight, Clock, Cpu, Calendar, Tag, Sparkles, Terminal, FileText } from 'lucide-astro';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts');
  return prompts.map((prompt) => ({
    params: { slug: prompt.slug },
    props: { prompt },
  }));
}

interface Props {
  prompt: CollectionEntry<'prompts'>;
}

const { prompt } = Astro.props;
const { Content } = await prompt.render();

const formattedDate = prompt.data.pubDate.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});

const categoryColorMap: Record<string, string> = {
  'SEO・ブログ': 'text-emerald-400 bg-emerald-500/10 border-emerald-500/30',
  'SNS・X運用': 'text-sky-400 bg-sky-500/10 border-sky-500/30',
  'LP・コピーライティング': 'text-amber-400 bg-amber-500/10 border-amber-500/30',
  'Claude Code自動化': 'text-purple-400 bg-purple-500/10 border-purple-500/30',
  'ディレクション': 'text-rose-400 bg-rose-500/10 border-rose-500/30',
};

const catBadgeStyle = categoryColorMap[prompt.data.category] || 'text-slate-300 bg-slate-800 border-slate-700';

// Canonical URL & Schema.org TechArticle JSON-LD
const articleUrl = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": prompt.data.title,
  "description": prompt.data.description,
  "datePublished": prompt.data.pubDate.toISOString(),
  "dateModified": prompt.data.pubDate.toISOString(),
  "inLanguage": "ja",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleUrl.toString(),
  },
  "author": {
    "@type": "Organization",
    "name": "PromptHub",
    "url": "https://prompt-hub-lab.github.io/prompt-hub/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PromptHub",
    "url": "https://prompt-hub-lab.github.io/prompt-hub/"
  },
  "proficiencyLevel": "Intermediate",
  "keywords": [prompt.data.category, prompt.data.targetModel, "AIプロンプト", "業務自動化"],
  "about": {
    "@type": "Thing",
    "name": prompt.data.category
  }
};
---

<Layout
  title={`${prompt.data.title} | PromptHub`}
  description={prompt.data.description}
  type="article"
  publishedTime={prompt.data.pubDate}
>
  <!-- Schema.org JSON-LD output in head slot -->
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 overflow-x-auto whitespace-nowrap">
    <a href={import.meta.env.BASE_URL} class="hover:text-white transition-colors">ホーム</a>
    <ChevronRight class="w-3.5 h-3.5 text-slate-600 flex-shrink-0" />
    <span class="text-slate-300">{prompt.data.category}</span>
    <ChevronRight class="w-3.5 h-3.5 text-slate-600 flex-shrink-0" />
    <span class="text-slate-400 truncate max-w-xs">{prompt.data.title}</span>
  </nav>

  <!-- Article Header -->
  <header class="space-y-4 mb-10 pb-8 border-b border-slate-800">
    <div class="flex flex-wrap items-center gap-3">
      <span class={`inline-block px-3 py-1 rounded-md text-xs font-semibold border ${catBadgeStyle}`}>
        {prompt.data.category}
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-medium text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-3 py-1 rounded-full">
        <Clock class="w-3.5 h-3.5" />
        {prompt.data.timeSaved}
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs text-slate-400 font-mono bg-slate-900 border border-slate-800 px-2.5 py-1 rounded-md">
        <Cpu class="w-3.5 h-3.5 text-brand-400" />
        {prompt.data.targetModel}
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs text-slate-400 ml-auto">
        <Calendar class="w-3.5 h-3.5 text-slate-500" />
        {formattedDate}
      </span>
    </div>

    <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white leading-tight">
      {prompt.data.title}
    </h1>

    <p class="text-base text-slate-300 leading-relaxed max-w-3xl">
      {prompt.data.description}
    </p>
  </header>

  <!-- Prompt Box (Hero Card) -->
  <section class="mb-12">
    <div class="rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl overflow-hidden">
      <!-- Prompt Header with Title and CopyButton -->
      <div class="bg-slate-950/90 px-5 py-3.5 border-b border-slate-800 flex items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-rose-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-amber-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
          <span class="ml-2 text-xs font-mono font-medium text-slate-400 flex items-center gap-1.5">
            <Terminal class="w-3.5 h-3.5 text-brand-400" />
            実戦プロンプト（ワンクリックコピー対応）
          </span>
        </div>

        <CopyButton text={prompt.data.promptText} />
      </div>

      <!-- Prompt Body -->
      <div class="p-6 overflow-x-auto max-h-[500px] overflow-y-auto bg-slate-950/50">
        <pre class="font-mono text-sm text-slate-200 whitespace-pre-wrap leading-relaxed selection:bg-brand-500/30 selection:text-white"><code>{prompt.data.promptText}</code></pre>
      </div>
    </div>
  </section>

  <!-- Note/Brain CTA Banner -->
  <section class="mb-14">
    <ConversionBanner noteUrl={prompt.data.noteUrl} category={prompt.data.category} />
  </section>

  <!-- Markdown Article Body: Execution Steps & Customization Tips -->
  <section class="bg-slate-900/60 rounded-2xl border border-slate-800/80 p-6 md:p-10 mb-14">
    <div class="flex items-center gap-2 text-brand-400 font-semibold text-sm mb-6 pb-3 border-b border-slate-800">
      <FileText class="w-4 h-4" />
      <span>プロンプトの解説と実務運用ガイド</span>
    </div>

    <div class="prose prose-invert max-w-none prose-headings:font-bold prose-headings:text-white prose-h3:text-xl prose-h4:text-lg prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-brand-400 hover:prose-a:underline prose-code:text-brand-300 prose-code:bg-slate-950 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 prose-li:text-slate-300">
      <Content />
    </div>
  </section>

  <!-- Bottom Back Navigation -->
  <div class="text-center">
    <a
      href={import.meta.env.BASE_URL}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 text-sm font-semibold text-slate-300 hover:text-white transition-all hover:scale-105"
    >
      <span>← プロンプト一覧に戻る</span>
    </a>
  </div>
</Layout>
